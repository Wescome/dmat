#lang racket/base
(require racket/format racket/list "families.rkt" "core/family.rkt" "core/judge.rkt")
;; Worst-profile SFR heat map: rows families, columns arms; cell shade by value; text value.
(define cw 0.98) (define ch 0.40)
(define labels (quote ("\\arm{Chor}" "\\arm{Fsm}" "\\arm{Comm}" "\\arm{Hybrid}" "\\arm{Hyb-noE}")))
(printf "\\begin{tikzpicture}[font=\\scriptsize]\n")
(for ([l labels] [i (in-naturals)]) (printf "\\node[anchor=south, font=\\tiny] at (~a,0.05) {~a};\n" (+ (* i cw) (/ cw 2)) l))
(for ([fn family-names] [r (in-naturals)])
  (define y (- (* (+ r 1) ch)))
  (printf "\\node[anchor=east] at (-0.05,~a) {\\texttt{~a}};\n" (+ y (/ ch 2)) fn)
  (for ([an ARM-NAMES] [i (in-naturals)])
    (define f (family-by-name fn))
    (define v (exact->inexact (apply max (for/list ([p (profile-names f)]) (hash-ref (exact-metrics f (arm-of fn an) p) 'SFR)))))
    (define shade (inexact->exact (round (* 100 (min 1 (/ v 0.6))))))
    (printf "\\fill[black!~a] (~a,~a) rectangle (~a,~a);\n" (* 0.7 shade) (* i cw) y (+ (* i cw) cw) (+ y ch))
    (printf "\\node[text=~a] at (~a,~a) {~a};\n" (if (> shade 55) "white" "black") (+ (* i cw) (/ cw 2)) (+ y (/ ch 2))
            (if (zero? v) "0" (~r v #:precision '(= 2))))))
(printf "\\draw[black!40] (0,~a) grid[xstep=~a,ystep=~a] (~a,0);\n" (- (* 8 ch)) cw ch (* 5 cw))
(printf "\\end{tikzpicture}\n")
